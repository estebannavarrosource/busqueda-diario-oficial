# Plantilla de configuración. Ver docs/INSTALACION.md §10.
# Servidor Linux: copiar a /etc/diario-oficial/diario-oficial.env
# Windows o desarrollo local: copiar a .env.local en la carpeta del proyecto

# PostgreSQL 15+. Obligatoria.
DATABASE_URL=postgresql://diario:CAMBIAR_ESTA_CLAVE@127.0.0.1:5432/diario_oficial

# PDFs en disco del servidor.
STORAGE_DRIVER=local
PDF_STORAGE_DIR=/var/lib/diario-oficial/pdfs

# Solo si se usa Chrome/Chromium del sistema (obligatorio en Windows, macOS y Linux ARM).
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/google-chrome
# CHROMIUM_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
TZ=America/Santiago
NEXT_TELEMETRY_DISABLED=1

# Módulo de expedientes (oculto por defecto). Poner "true" para mostrarlo.
HABILITAR_EXPEDIENTES=false

# Logs: debug | info | warn | error. "debug" solo para diagnosticar temporalmente.
LOG_LEVEL=info
# "json" emite una línea JSON por evento (Loki, ELK, jq). Por defecto, texto legible.
# LOG_FORMAT=json
