# Copiar a .env.local y completar. Ver docs/INSTALACION.md §7.

# PostgreSQL (Neon recomendado). Obligatoria.
DATABASE_URL=postgresql://usuario:clave@host:5432/basedatos?sslmode=require

# Token de un store de Vercel Blob con acceso público. Necesario para descargar PDFs.
BLOB_READ_WRITE_TOKEN=

# Solo en Windows, macOS o Linux ARM: ruta al ejecutable de Chrome/Chromium.
# CHROMIUM_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
